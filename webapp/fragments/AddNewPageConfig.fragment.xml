<core:FragmentDefinition xmlns="sap.m" xmlns:l="sap.ui.layout" xmlns:f="sap.ui.layout.form" xmlns:core="sap.ui.core"
	xmlns:variant="sap.ui.comp.variants">
		<Dialog id="addNewPageConfigDialog" title="Add New Page" width="500em">
	<f:SimpleForm editable="true" class="" layout="ResponsiveGridLayout" columnsM="5" columnsL="5" columnsXL="5" labelSpanM="5" labelSpanL="5">
				<Label text="Page Binding"/>
				<CheckBox id="pageBindingCheckBox" selected="{oTileDataModel>/showPageBinding}" text="Bind to Existing Page"/>
				
				<Label text="Select Existing Page" visible="{oTileDataModel>/showPageBinding}" required="true"/>
				<ComboBox 
					id="landingPageComboBox" 
					visible="{oTileDataModel>/showPageBinding}"
					items="{oLandingPageModel>/}"
					selectedKey="{oTileDataModel>/ZlevelId}"
					placeholder="Select a landing page"
					required="true">
					<core:Item key="{oLandingPageModel>ZlevelId}" text="{oLandingPageModel>Ztitle}"/>
				</ComboBox>
				
				<Label text="Page Title" required="true"/>
				<Input id="pageConfigTitleInput" value="" placeholder="Enter page title" required="true"/>
				
				<Label text="Roles"/>
				<Input id="pageConfigRolesInput" value="" placeholder="Enter roles (comma separated)"/>
				
				<Label text="Visibility"/>
				<CheckBox id="pageConfigVisibilityCheckBox" selected="true" text="Visible"/>
		</f:SimpleForm>
			<buttons>
			<Button text="Add" type="Emphasized" press="onAddPageConfigItem"/>
			<Button text="Cancel" press="onCloseAddNewPageConfigDialog"/>
			</buttons>
	</Dialog>
</core:FragmentDefinition>