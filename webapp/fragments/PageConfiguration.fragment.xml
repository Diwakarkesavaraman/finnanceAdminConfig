<core:FragmentDefinition xmlns:core="sap.ui.core" xmlns="sap.m">
	<Panel id="pageConfigurationContainer" visible="false" height="100%" class="admgisreppanelcls">
		<content>
			<HBox class="tblhdrcls">
				<Text text="Page Configuration"/>
				<HBox>
					<Button type="Reject" text="Delete" press="onDeletePageConfig"/>
					<ToolbarSpacer width="0.5rem"/>
					<Button type="Accept" text="Update" press="onUpdatePageConfig"/>
					<ToolbarSpacer width="0.5rem"/>
					<Button type="Emphasized" icon="sap-icon://add" text="Add" press="onAddPageConfig"/>
				</HBox>
			</HBox>
			<Table id="pageConfigTable" alternateRowColors="false" items="{ path: 'oPageConfigDataModel>/' }" growing="true" class="blueBackground surveytablecls"
				mode="MultiSelect" selectionChange="onPageConfigSelectionChange">
				<columns>
					<Column width="9rem">
						<header>
							<Text text="Page Title" class="whiteLabel"/>
						</header>
					</Column>
					<Column width="9rem">
						<header>
							<Text text="Tab Name" class="whiteLabel"/>
						</header>
					</Column>
					<Column>
						<header>
							<Text text="Roles" class="whiteLabel"/>
						</header>
					</Column>
					<Column width="7rem">
						<header>
							<Text text="Visibility" class="whiteLabel"/>
						</header>
					</Column>
				</columns>
				<items>
					<ColumnListItem vAlign="Middle" type="Navigation" press="onPageConfigPress">
						<cells>
							<Input value="{oPageConfigDataModel>ZpageName}"/>
							<Input value="{oPageConfigDataModel>ZtabName}"/>
							<Input value="{oPageConfigDataModel>Zrole}"/>
							<CheckBox text="" selected="{oPageConfigDataModel>Zvisibility}"/>
						</cells>
					</ColumnListItem>
				</items>
			</Table>
		</content>
	</Panel>
	<Panel id="pageWidgetConfigContainer" visible="false" height="100%" class="admgisreppanelcls">
		<content>
			<HBox class="tblhdrcls">
				<HBox alignItems="Center">
					<Button id="backToPageConfigBtn" text="" icon="sap-icon://nav-back" press="onBackToPageConfig"/>
					<Text id="selectedPageConfigTitle" text="Page Widgets" class="sapUiTinyMarginBegin"/>
				</HBox>
				<HBox>
					<Button type="Emphasized" icon="sap-icon://add" text="Add Widget to Page" press="onAddWidgetToPageConfig"/>
				</HBox>
			</HBox>
			<Table id="pageWidgetConfigTable" alternateRowColors="false" items="{ path: 'oPageWidgetConfigDataModel>/' }" growing="true" class="blueBackground surveytablecls"
				mode="MultiSelect" selectionChange="onPageWidgetConfigSelectionChange">
				<columns>
					<Column width="9rem">
						<header>
							<Text text="Widget Name" class="whiteLabel"/>
						</header>
					</Column>
					<Column>
						<header>
							<Text text="Widget Type" class="whiteLabel"/>
						</header>
					</Column>
					<Column width="7rem">
						<header>
							<Text text="Chart Type" class="whiteLabel"/>
						</header>
					</Column>
					<Column width="5rem">
						<header>
							<Text text="Actions" class="whiteLabel"/>
						</header>
					</Column>
				</columns>
				<items>
					<ColumnListItem vAlign="Middle" type="Navigation" press="onPageWidgetConfigPress">
						<cells>
							<Text text="{oPageWidgetConfigDataModel>WidgetName}"/>
							<Text text="{oPageWidgetConfigDataModel>WidgetType}"/>
							<Text text="{oPageWidgetConfigDataModel>ChartType}"/>
							<Button type="Reject" icon="sap-icon://delete" press="onRemoveWidgetFromPageConfig"/>
						</cells>
					</ColumnListItem>
				</items>
			</Table>
		</content>
	</Panel>
	<Panel id="pageWidgetDetailConfig" visible="false" height="100%" class="admgisreppanelcls">
		<content>
			<HBox class="tblhdrcls">
				<HBox alignItems="Center">
					<Button id="backToPageWidgetConfigBtn" text="" icon="sap-icon://nav-back" press="onBackToPageWidgetConfig"/>
					<Text id="pageWidgetDetailTitle" text="Widget Config" class="sapUiTinyMarginBegin"/>
				</HBox>
				<HBox>
					<Button type="Reject" text="Delete" press="onDeleteWidget"/>
					<ToolbarSpacer width="0.5rem"/>
					<Button type="Accept" text="Update" press="onUpdateWidget"/>
					<ToolbarSpacer width="0.5rem"/>
					<Button type="Emphasized" icon="sap-icon://add" text="Add" press="onAddWidget"/>
				</HBox>
			</HBox>
			<Table id="pageWidgetDetailTable" alternateRowColors="false" items="{ path: 'oWidgetDataModel>/' }" growing="true"
				class="blueBackground surveytablecls" mode="MultiSelect" selectionChange="onWidgetSelectionChange">
				<dragDropConfig>
					<dnd:DragInfo xmlns:dnd="sap.ui.core.dnd" sourceAggregation="items" />
					<dnd:DropInfo xmlns:dnd="sap.ui.core.dnd" targetAggregation="items" dropPosition="Between" dropLayout="Vertical" drop="onWidgetDrop"/>
				</dragDropConfig>
				<columns>
					<Column width="5rem">
						<header>
							<Text text="Tile ID" class="whiteLabel"/>
						</header>
					</Column>
					<Column width="5rem">
						<header>
							<Text text="Page ID" class="whiteLabel"/>
						</header>
					</Column>
					<Column width="5rem">
						<header>
							<Text text="Widget ID" class="whiteLabel"/>
						</header>
					</Column>
					<Column width="12rem">
						<header>
							<Text text="Widget Name" class="whiteLabel"/>
						</header>
					</Column>
					<Column width="5rem">
						<header>
							<Text text="Roles" class="whiteLabel"/>
						</header>
					</Column>
					<Column width="7rem">
						<header>
							<Text text="Visibility" class="whiteLabel"/>
						</header>
					</Column>
				</columns>
				<items>
					<ColumnListItem vAlign="Middle" type="Navigation" press="onWidgetPress">
						<cells>
							<Input value="{oWidgetDataModel>ZtitleName}"/>
							<Input value="{oWidgetDataModel>ZpageName}"/>
							<Input value="{oWidgetDataModel>WidgetId}"/>
							<Input value="{oWidgetDataModel>WidgetName}"/>
							<Input value="{oWidgetDataModel>Zrole}"/>
							<CheckBox text="" selected="{oWidgetDataModel>Zvisibility}"/>
						</cells>
					</ColumnListItem>
				</items>
			</Table>
		</content>
	</Panel>
</core:FragmentDefinition>
