<core:FragmentDefinition xmlns:form="sap.ui.layout.form" xmlns:layout="sap.ui.layout" xmlns:core="sap.ui.core" xmlns:u="sap.ui.unified"
	xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:viz="sap.viz.ui5.controls" xmlns:viz.feeds="sap.viz.ui5.controls.common.feeds"
	xmlns:viz.data="sap.viz.ui5.data" xmlns:w="sap.ui.integration.widgets" xmlns:f="sap.f" xmlns:tnt="sap.tnt" beforeShow="onBeforeShow">
	<ScrollContainer id="admincontrolsurvey" horizontal="true" vertical="true" height="50%" class="sapUiContentPadding">
		<Panel height="100%" class="admgisreppanelcls">
			<content>
				<HBox class="tblhdrcls">
					<Text text="Survey Form Config"/>
					<HBox>
						<Button type="Reject" text="Delete" press="onDeleteSurveyTabCon"/>
						<ToolbarSpacer width="0.5rem"/>
						<Button type="Accept" text="Update" press="onUpdateSurveyTab"/>
						<ToolbarSpacer width="0.5rem"/>
						<Button type="Emphasized" icon="sap-icon://add" text="Add" press="onAddNewSurveyTab"/>
					</HBox>
				</HBox>
				<Table id="surveyTab" alternateRowColors="false" items="{ path: 'oSurveyTabModel>/', sorter: {path: 'SurveyId', descending: false}}"
					growing="true" class="blueBackground surveytablecls" mode="MultiSelect" selectionChange="onSelectionChange">
					<columns>
						<!--<Column width="7rem">-->
						<!--	<header>-->
						<!--		<Text text="Survey ID" class="whiteLabel"></Text>-->
						<!--	</header>-->
						<!--</Column>-->
						<Column width="7rem">
							<header>
								<Text text="Survey Name" class="whiteLabel"></Text>
							</header>
						</Column>
						<Column width="15rem">
							<header>
								<Text text="Survey URL" class="whiteLabel"></Text>
							</header>
						</Column>
						<Column width="10rem">
							<header>
								<Text text="Start Date" class="whiteLabel"></Text>
							</header>
						</Column>
						<Column width="10rem">
							<header>
								<Text text="End Date" class="whiteLabel"></Text>
							</header>
						</Column>
						<Column width="15rem">
							<header>
								<Text text="Roles" class="whiteLabel"></Text>
							</header>
						</Column>
						<Column width="5rem">
							<header>
								<Text text="Visibility" class="whiteLabel"></Text>
							</header>
						</Column>
					</columns>
					<items>
						<ColumnListItem vAlign="Middle">
							<cells>
								<!--<Input value="{oVisiblityModel>ZkpiId}"></Input>-->
								<!--<Text text="{oSurveyTabModel>SurveyId}"></Text>-->
								<!--<Input value="{oVisiblityModel>Zcategory}"></Input>-->
								<!--<Text text="{oMarketWatchTabModel>Zcategory}"></Text>-->
								<Input value="{oSurveyTabModel>SurveyName}"></Input>
								<Input value="{oSurveyTabModel>SurveyUrl}"></Input>
								<!--<Input value="{oSurveyTabModel>SurveyName}"></Input>-->
								<DatePicker id="inpsurveydate"
									value="{path:'oSurveyTabModel>StartDate', type:'sap.ui.model.type.Date', formatOptions: { UTC: true, style: 'medium', strictParsing: true }}"
									placeholder="mm/dd/yyyy" change="onLoadFilterData" class="customDatePicker" required="true"></DatePicker>
								<DatePicker id="inpsurveyenddate"
									value="{path:'oSurveyTabModel>EndDate', type:'sap.ui.model.type.Date', formatOptions: { UTC: true, style: 'medium', strictParsing: true }}"
									placeholder="mm/dd/yyyy" change="onLoadFilterData" class="customDatePicker" required="true"></DatePicker>
								<!--<MultiInput tokens="{ path: 'oVisiblityModel>arr',templateShareable: false }" width="80%" valueHelpRequest="onKPIRoleValueHelp"-->
								<!--	showValueHelp="true">-->
								<!--	<tokens>-->
								<!--		<Token key="{oVisiblityModel>Value1}" text="{oVisiblityModel>Value1}"/>-->
								<!--	</tokens>-->
								<!--</MultiInput>-->
								<Input value="{oSurveyTabModel>role}"></Input>
								<CheckBox text="" selected="{oSurveyTabModel>Visibiliyy}"/>
								<!--<Input id="roleid" mode="MultiSelect" value="oVisiblityModel>ZroleList" showValueHelp="true"-->
								<!--	valueHelpRequest="onRoleValueHelp" placeholder="Select Color"></Input>-->
							</cells>
						</ColumnListItem>
					</items>
				</Table>
			</content>
		</Panel>
	</ScrollContainer>
</core:FragmentDefinition>