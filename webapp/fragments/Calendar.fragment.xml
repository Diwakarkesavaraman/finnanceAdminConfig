<core:FragmentDefinition xmlns:form="sap.ui.layout.form" xmlns:layout="sap.ui.layout" xmlns:core="sap.ui.core" xmlns:u="sap.ui.unified"
	xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:viz="sap.viz.ui5.controls" xmlns:viz.feeds="sap.viz.ui5.controls.common.feeds"
	xmlns:viz.data="sap.viz.ui5.data" xmlns:w="sap.ui.integration.widgets" xmlns:f="sap.f" xmlns:tnt="sap.tnt" beforeShow="onBeforeShow">
	<ScrollContainer id="admincontrolgiscalendar" horizontal="true" vertical="true" height="50%" class="sapUiContentPadding">
		<Panel height="100%" class="admgisreppanelcls">
			<content>
				<IconTabBar id="calendarIconTabBar" select="onCalendarTabSelect" class="sapUiResponsiveContentPadding admncntrlstabcls">
					<items>
						<!-- Financial Calendar Config Tab -->
						<IconTabFilter text="Financial Calendar Config" key="calendar">
							<VBox>
								<HBox class="tblhdrcls">
									<Text text="Financial Calendar Config"/>
									<HBox>
										<Button type="Reject" text="Delete Event" press="onDeleteCalendarItems"/>
										<ToolbarSpacer width="0.5rem"/>
										<Button type="Accept" text="Update Event" press="onUpdateCalendarDets"/>
										<ToolbarSpacer width="0.5rem"/>
										<Button type="Emphasized" icon="sap-icon://add" text="Add Event" press="onAddNewCalendarItem"/>
									</HBox>
								</HBox>
								<Table id="tabCalendar" alternateRowColors="false" items="{ path: 'oCalendarModel>/'}" growing="true" class="blueBackground surveytablecls"
									mode="MultiSelect" selectionChange="onSelectionChange">
									<columns>
										<Column>
											<header>
												<Text text="Start Date" class="whiteLabel"></Text>
											</header>
										</Column>
										<Column>
											<header>
												<Text text="End Date" class="whiteLabel"></Text>
											</header>
										</Column>
										<Column>
											<header>
												<Text text="Event Category" class="whiteLabel"></Text>
											</header>
										</Column>
										<Column>
											<header>
												<Text text="Event" class="whiteLabel"></Text>
											</header>
										</Column>
										<Column>
											<header>
												<Text text="Short Description" class="whiteLabel"></Text>
											</header>
										</Column>
										<Column>
											<header>
												<Text text="Detailed Description" class="whiteLabel"></Text>
											</header>
										</Column>
										<Column>
											<header>
												<Text text="Color" class="whiteLabel"></Text>
											</header>
										</Column>
									</columns>
									<items>
										<ColumnListItem vAlign="Middle">
											<cells>
												<DatePicker id="inpcaldate"
													value="{path:'oCalendarModel>Zstartdate', type:'sap.ui.model.type.Date', formatOptions: { UTC: true, style: 'medium', strictParsing: true }}"
													placeholder="mm/dd/yyyy" change="onLoadFilterData" class="customDatePicker" required="true"></DatePicker>
												<DatePicker id="inpcalenddate"
													value="{path:'oCalendarModel>Zenddate', type:'sap.ui.model.type.Date', formatOptions: { UTC: true, style: 'medium', strictParsing: true }}"
													placeholder="mm/dd/yyyy" change="onLoadFilterData" class="customDatePicker" required="true"></DatePicker>
												<Select selectedKey="{oCalendarModel>Zcategory}" change="onCalendarCategoryChange" forceSelection="false" width="100%" items="{path: 'oCategoryListModel>/'}">
													<core:Item key="{oCategoryListModel>CatId}" text="{oCategoryListModel>Category}"/>
												</Select>
												<Input value="{oCalendarModel>Zevent}"></Input>
												<Input value="{oCalendarModel>Zshortdesp}"></Input>
												<Input value="{oCalendarModel>Zdetaildesp}"></Input>
												<Input id="colorcode" value="{path: 'oCalendarModel>Zcolor', formatter: '.formatter.formatColor'}" showValueHelp="true" valueHelpRequest="onColorValueHelp" placeholder="Select Color"></Input>
											</cells>
										</ColumnListItem>
									</items>
								</Table>
							</VBox>
						</IconTabFilter>

						<!-- Category Config Tab -->
						<IconTabFilter text="Category Config" key="category">
							<VBox>
								<HBox class="tblhdrcls">
									<Text text="Category Config"/>
									<HBox>
										<Button type="Reject" text="Delete Category" press="onDeleteCategoryItems"/>
										<ToolbarSpacer width="0.5rem"/>
										<Button type="Accept" text="Update Category" press="onUpdateCategoryDets"/>
										<ToolbarSpacer width="0.5rem"/>
										<Button type="Emphasized" icon="sap-icon://add" text="Add Category" press="onAddNewCategoryItem"/>
									</HBox>
								</HBox>
								<Table id="tabCategory" alternateRowColors="false" items="{ path: 'oCategoryModel>/'}" growing="true" class="blueBackground surveytablecls"
									mode="MultiSelect">
									<columns>
										<Column>
											<header>
												<Text text="Category ID" class="whiteLabel"></Text>
											</header>
										</Column>
										<Column>
											<header>
												<Text text="Category Name" class="whiteLabel"></Text>
											</header>
										</Column>
										<Column>
											<header>
												<Text text="Color" class="whiteLabel"></Text>
											</header>
										</Column>
									</columns>
									<items>
										<ColumnListItem vAlign="Middle">
											<cells>
												<Input value="{oCategoryModel>CatId}" editable="false"></Input>
												<Input value="{oCategoryModel>Category}"></Input>
												<Input id="categoryColorCode" value="{oCategoryModel>Color}" change="onCategoryColorChange" showValueHelp="true" valueHelpRequest="onCategoryColorValueHelp" placeholder="Select Color"></Input>
											</cells>
										</ColumnListItem>
									</items>
								</Table>
							</VBox>
						</IconTabFilter>
					</items>
				</IconTabBar>
			</content>
		</Panel>
	</ScrollContainer>
</core:FragmentDefinition>
